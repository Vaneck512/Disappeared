{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/disappeared",
        "sources": "https://github.com/Vanek512/Disappeared",
        "issues": "https://github.com/Vanek512/Disappeared/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "client",
    "entrypoints": {
        "main": [
          "ru.vaneck.disappeared.DisappearedFabric"
        ],
        "modmenu": [
            "ru.vaneck.disappeared.integration.modmenu.ModMenuApiImpl"
        ]
    },
    "custom": {
        "modmenu": {
            "links": {
                "Modrinth": "https://modrinth.com/mod/disappeared",
                "YouTube": "https://www.youtube.com/@vaneck512-mods"
            }
        }
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": "*",
        "cloth_config": "*"
    }
}
  